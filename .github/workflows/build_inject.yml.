name: build-inject

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Setup NDK
        uses: nttld/setup-ndk@v1
        with:
          ndk-version: r26d
          local-cache: true

      - name: Compile injector
        run: |
          CLANG=$ANDROID_NDK_HOME/toolchains/llvm/prebuilt/linux-x86_64/bin/clang++
          $CLANG --target=aarch64-linux-android24 -O2 -static-libstdc++ \
            -o crez_inject src/crez_inject.cpp -ldl
          file crez_inject

      - name: Upload
        uses: actions/upload-artifact@v4
        with:
          name: crez_inject
          path: crez_inject
